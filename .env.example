# =============================================================================
# PharmaGuard - Environment Configuration Template
# Copy this file to `.env` (root) and/or `.env.local` per app and fill in real
# values. NEVER commit .env or .env.local. NEVER prefix a secret with
# NEXT_PUBLIC_.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development

# --- Backend API (apps/api) --------------------------------------------------
PORT=4000
API_URL=http://localhost:4000

# Public URL of the frontend. Used for CORS allowlist and password-reset
# redirect target.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the authenticated API.
# Never use "*" for the authenticated API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set cookie "Secure" attribute (enable in production / any HTTPS deployment).
COOKIE_SECURE=false

# --- Supabase (server-only secrets - NEVER expose to the browser) -----------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
SUPABASE_SECRET_KEY=<server-only-secret-key>
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# --- Frontend (apps/web) ------------------------------------------------------
# Public runtime values only (safe for the browser bundle):
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>

# --- AI / OCR (apps/api only - Phase 5) --------------------------------------
GEMINI_API_KEY=
# Optional vision model override (defaults to gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# --- Expiry engine (apps/api - Phase 6, TRD §10) ------------------------------
# Days-left thresholds for the CRITICAL and WARNING expiry buckets.
EXPIRY_CRITICAL_DAYS=30
EXPIRY_WARNING_DAYS=90

# --- Audit -------------------------------------------------------------------
# Optional salt used when hashing IPs before writing audit metadata.
AUDIT_IP_SALT=
